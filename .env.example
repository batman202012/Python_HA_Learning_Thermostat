# --- HOME ASSISTANT CONNECTION SETTINGS ---
HA_TOKEN=your_long_lived_access_token_here
HA_ADD=127.0.0.1:8123
CLIMATE_ENTITY_ID=climate.your_thermostat_name

# --- ELECTRICITY PRICE RATES & MONITORING ---
MONITOR_PRICE_ENTITY=sensor.electricity_price
PEAK_PRICE_THRESHOLD=0.35

# --- AI TEMPERATURE SAFETY RAILS ---
SAFETY_MIN=68.0
SAFETY_MAX=78.0

# --- SENS55 AIR QUALITY & VENTILATION SYSTEM ---
ENABLE_AQ_FEATURE=True
SWAMP_COOLER_ENTITY_ID=switch.your_swamp_cooler_switch

# VOC Index Configuration (Typically ranges from 0 to 500)
AQ_VOC_SENSOR=sensor.sens55_voc_index
AQ_VOC_THRESHOLD=150.0
AQ_VOC_CLEAN_THRESHOLD=100.0

# NOx Index Configuration (Typically ranges from 0 to 500)
AQ_NOX_SENSOR=sensor.sens55_nox_index
AQ_NOX_THRESHOLD=120.0
AQ_NOX_CLEAN_THRESHOLD=70.0

# CO2 PPM Configuration (Parts Per Million)
AQ_CO2_SENSOR=sensor.sens55_co2_ppm
AQ_CO2_THRESHOLD=1100.0
AQ_CO2_CLEAN_THRESHOLD=800.0
